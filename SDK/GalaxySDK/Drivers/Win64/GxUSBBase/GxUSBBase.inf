;------------------------------------------------------------------------------
;  Windows 98 Sections
;------------------------------------------------------------------------------
[DriverInstall]
CopyFiles=DriverCopyFiles
AddReg=DriverAddReg

[DriverCopyFiles]
GxUSBBase.sys

[DriverAddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,GxUSBBase.sys

;------------------------------------------------------------------------------
;  x86 Sections
;------------------------------------------------------------------------------
[DriverInstall.NTx86]
CopyFiles=DriverCopyFiles
AddReg=DriverAddReg.NTx86

[DriverInstall.NTx86.Services]
AddService=GxUSBBase,2,DriverService

[DriverService]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%10%\system32\drivers\GxUSBBase.sys

[DriverAddReg.NTx86]
HKLM,%SPEEDPARAM%,BufferSize,0x00010001,0

;------------------------------------------------------------------------------
;  amd64 Sections
;------------------------------------------------------------------------------
[DriverInstall.NTamd64]
CopyFiles=DriverCopyFiles
AddReg=DriverAddReg.NTamd64

[DriverInstall.NTamd64.Services]
AddService=GxUSBBase,2,DriverService

[DriverAddReg.NTamd64]
HKLM,%SPEEDPARAM%,BufferSize,0x00010001,0

;------------------------------------------------------------------------------
;  WDF Coinstaller installation
;------------------------------------------------------------------------------
[SourceDisksFiles]
WdfCoInstaller01009.dll=1

[DestinationDirs]
CoInstaller_CopyFiles = 11

[DriverInstall.NTx86.CoInstallers]
AddReg=CoInstaller_AddReg
CopyFiles=CoInstaller_CopyFiles

[DriverInstall.NTamd64.CoInstallers]
AddReg=CoInstaller_AddReg
CopyFiles=CoInstaller_CopyFiles

[CoInstaller_CopyFiles]
WdfCoInstaller01009.dll

[CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller01009.dll,WdfCoInstaller"

[DriverInstall.NTx86.Wdf]
KmdfService = GxUSBBase, wdfsect

[DriverInstall.NTamd64.Wdf]
KmdfService = GxUSBBase, wdfsect

[wdfsect]
KmdfLibraryVersion = 1.9

;------------------------------------------------------------------------------
;  String Definitions
;------------------------------------------------------------------------------
[Strings]
ProviderName=" "
MFGNAME=" "
ClassName="Machine Vision Digital Cameras"
INSTDISK="USB Digital Camera Installation Disc"
DESCRIPTION="USB2.0 Digital Camera"
SPEEDPARAM="System\CurrentControlSet\Services\GxUSBBase\Parameters"
