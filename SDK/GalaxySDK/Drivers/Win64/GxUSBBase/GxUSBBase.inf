; GxUSBBase.inf
; GxUSBBase Digital Camera install information file

[Version]
Signature=$CHICAGO$
Class=USBCamera
ClassGUID={BBC1DEBB-9251-41ec-86B6-30C660BA583C}
Provider=%ProviderName%
DriverVer=01/17/2017,1.1.1701.8171
CatalogFile=GxUSBBase.cat

[ClassInstall32]
Addreg=USBCamClassReg     

[USBCamClassReg]
HKR,,,0,%ClassName%
HKR,,Icon,,-20

[Manufacturer]
%MFGNAME%=DeviceList,NTx86,NTamd64

[DestinationDirs]
DefaultDestDir=10,System32\Drivers

[SourceDisksNames]
1=%INSTDISK%,,0

[SourceDisksFiles]
GxUSBBase.sys=1

[SourceDisksFiles.x86]
GxUSBBase.sys=1

[SourceDisksFiles.amd64]
GxUSBBase.sys=1

[DeviceList]
;%DESCRIPTION%=DriverInstall, USB\VID_4448&PID_5654
;%DESCRIPTION%=DriverInstall, USB\VID_4448&PID_5655
;%DESCRIPTION%=DriverInstall, USB\VID_4448&PID_5656
