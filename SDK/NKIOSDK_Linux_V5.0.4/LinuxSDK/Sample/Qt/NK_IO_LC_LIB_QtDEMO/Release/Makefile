install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/NK_IO_LC_TEST_Qt/bin || mkdir -p $(INSTALL_ROOT)/opt/NK_IO_LC_TEST_Qt/bin
	-$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/NK_IO_LC_TEST_Qt/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/opt/NK_IO_LC_TEST_Qt/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/NK_IO_LC_TEST_Qt/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/NK_IO_LC_TEST_Qt/bin/ 


