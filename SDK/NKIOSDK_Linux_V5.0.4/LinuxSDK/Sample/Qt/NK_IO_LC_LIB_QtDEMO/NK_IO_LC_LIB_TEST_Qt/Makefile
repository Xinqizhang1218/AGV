	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents mainWindow.qrc $(DISTDIR)/
	$(COPY_FILE) --parents /home/tom/Qt5.13.2/5.13.2/gcc_64/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents NK_IO_LC_LIB.h dioLcAdapter.h dioTestPage.h ledWidget.h lightControlPage.h loginDialog.h mainWindow.h navigationWidget.h rightWidget.h switchButton.h $(DISTDIR)/
